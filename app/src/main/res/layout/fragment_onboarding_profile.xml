<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_100"
    tools:layout_editor_absoluteX="0dp"
    tools:layout_editor_absoluteY="-10dp">

    <!-- 카메라 버튼 -->

    <!-- 닉네임 라벨 -->

    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="156dp"
        android:padding="0dp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- 입력창 -->

    <!-- 안내 문구 -->

    <EditText
        android:id="@+id/et_nickname"
        style="@style/InputBlackStyle"
        android:layout_width="360dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:hint="@string/onboarding_placeholder"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:textSize="16sp"
        android:background="@drawable/bg_input_black_round"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.509"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_nickname" />

    <TextView
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/onboarding_nickname"
        android:textColor="@color/neutral_900"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/et_nickname"
        app:layout_constraintTop_toBottomOf="@id/iv_image" />

    <TextView
        android:id="@+id/tv_information"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/onboarding_nickname_valid"
        android:textColor="@color/neutral_400"
        app:layout_constraintStart_toStartOf="@id/et_nickname"
        app:layout_constraintTop_toBottomOf="@id/et_nickname" />

    <!-- 다음 버튼 (하단 고정) -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="360dp"
        android:layout_height="56dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/btn_round_selector"
        android:enabled="false"
        android:text="@string/next_button"
        android:textColor="@color/btn_text_selector"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>