<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_100">

    <View
        android:id="@+id/view_top_mask"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="@color/neutral_200"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/neutral_200"
        android:paddingHorizontal="16dp"
        android:paddingVertical="18dp"
        app:layout_constraintTop_toBottomOf="@id/view_top_mask"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="54dp"
            android:layout_height="37dp"
            android:src="@drawable/ic_logo_header"
            android:scaleType="fitStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_music_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="오늘의 음악 추천"
        android:textColor="@color/neutral_900"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_music"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/neutral_100"
        app:layout_constraintTop_toBottomOf="@id/tv_music_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_music_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:background="@color/neutral_200"
                app:layout_constraintDimensionRatio="H,16:9"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/white"
                app:layout_constraintTop_toTopOf="@id/iv_music_thumbnail"
                app:layout_constraintBottom_toBottomOf="@id/iv_music_thumbnail"
                app:layout_constraintStart_toStartOf="@id/iv_music_thumbnail"
                app:layout_constraintEnd_toEndOf="@id/iv_music_thumbnail"/>

            <TextView
                android:id="@+id/tv_music_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="행운을 빌어줘"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toTopOf="@id/tv_music_artist"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_music_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원필"
                android:textColor="@color/neutral_300"
                android:textSize="14sp"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_post_list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="추천글 보기"
        android:textColor="@color/neutral_900"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/card_music"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/btn_go_post_list"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/arrow_forward"
        app:tint="@color/neutral_900"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tv_post_list_title"
        app:layout_constraintTop_toTopOf="@id/tv_post_list_title"
        android:layout_marginEnd="4dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_home_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/tv_post_list_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_post_card"
        tools:itemCount="3"/>

</androidx.constraintlayout.widget.ConstraintLayout>