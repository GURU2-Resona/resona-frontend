<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Theme.RESONA" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    </style>

    <style name="TextAppearance.Resona" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/font</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Resona.Head" parent="TextAppearance.Resona">
        <item name="android:textSize">24sp</item>
        <item name="lineHeight">33.6sp</item>
    </style>
    <style name="TextAppearance.Resona.Head.Bold" parent="TextAppearance.Resona.Head">
        <item name="android:fontFamily">@font/pretendard_bold</item>
    </style>

    <style name="TextAppearance.Resona.Title" parent="TextAppearance.Resona">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">28sp</item>
    </style>
    <style name="TextAppearance.Resona.Title.SemiBold" parent="TextAppearance.Resona.Title">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
    </style>

    <style name="TextAppearance.Resona.Body1" parent="TextAppearance.Resona">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">22.4sp</item>
    </style>
    <style name="TextAppearance.Resona.Body1.Bold" parent="TextAppearance.Resona.Body1">
        <item name="android:fontFamily">@font/pretendard_bold</item>
    </style>

    <style name="TextAppearance.Resona.Body2" parent="TextAppearance.Resona">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">19.6sp</item>
    </style>
    <style name="TextAppearance.Resona.Body2.Bold" parent="TextAppearance.Resona.Body2">
        <item name="android:fontFamily">@font/pretendard_bold</item>
    </style>

    <style name="TextAppearance.Resona.Caption" parent="TextAppearance.Resona">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16.8sp</item>
    </style>
    <style name="TextAppearance.Resona.Caption.Bold" parent="TextAppearance.Resona.Caption">
        <item name="android:fontFamily">@font/pretendard_bold</item>
    </style>

    <style name="CustomButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_recommend_btn_select</item>
    </style>

    <style name="ShapeAppearance.Resona.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>