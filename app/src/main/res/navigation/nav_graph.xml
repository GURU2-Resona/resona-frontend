<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_splash">

    <fragment
        android:id="@+id/navigation_splash"
        android:name="com.example.resona.SplashFragment"
        android:label="Splash" />

    <fragment
        android:id="@+id/navigation_login"
        android:name="com.example.resona.LoginFragment"
        android:label="Login" />

    <fragment
        android:id="@+id/navigation_login_loading"
        android:name="com.example.resona.LoginLoadingFragment"
        android:label="Login_Loading"/>

    <fragment
        android:id="@+id/navigation_onboarding_profile"
        android:name="com.example.resona.OnboardingProfileFragment"
        android:label="Onboarding_Profile" />

    <fragment
        android:id="@+id/navigation_onboarding_recommend"
        android:name="com.example.resona.OnboardingRecommendFragment"
        android:label="Onboarding_Recommend" />

    <fragment
        android:id="@+id/navigation_onboarding_result"
        android:name="com.example.resona.OnboardingResultFragment"
        android:label="Onboarding_Result" />

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.resona.ui.HomeFragment"
        android:label="홈" />

    <fragment
        android:id="@+id/navigation_post_write"
        android:name="com.example.resona.ui.post.fragment.PostWriteFragment"
        android:label="추천글 작성">
        <action
            android:id="@+id/action_postWrite_to_postCategory"
            app:destination="@id/navigation_post_category" />
    </fragment>

    <fragment
        android:id="@+id/navigation_post_category"
        android:name="com.example.resona.ui.post.fragment.PostCategoryFragment"
        android:label="카테고리 선택">
        <argument android:name="userSubject" app:argType="string" />
        <argument android:name="userContent" app:argType="string" />
        <argument android:name="videoId" app:argType="string" />
        <argument android:name="songTitle" app:argType="string" />
        <argument android:name="singer" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/navigation_mypage"
        android:name="com.example.resona.ui.my.MypageFragment"
        android:label="마이페이지">
        <argument
            android:name="isMyProfile"
            app:argType="boolean"
            android:defaultValue="true" />
        <argument
            android:name="nickname"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_to_postList"
            app:destination="@id/navigation_post_list" />
    </fragment>

    <fragment
        android:id="@+id/navigation_other_profile"
        android:name="com.example.resona.ui.my.OtherProfileFragment"
        android:label="타인 프로필">

        <argument
            android:name="memberId"
            app:argType="long" />

        <action
            android:id="@+id/action_otherProfile_to_postList"
            app:destination="@id/navigation_post_list" />
    </fragment>

    <fragment
        android:id="@+id/navigation_post_list"
        android:name="com.example.resona.ui.post.fragment.PostListFragment"
        android:label="게시글 목록">
        <argument
            android:name="postType"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/navigation_post_detail"
        android:name="com.example.resona.ui.post.fragment.PostDetailFragment"
        android:label="추천글 상세">
        <argument android:name="postId" app:argType="long" />

        <action
            android:id="@+id/action_postDetail_to_postDetailShare"
            app:destination="@id/navigation_post_detail_share"
            app:popUpTo="@id/navigation_post_detail"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_postDetail_to_otherProfile"
            app:destination="@id/navigation_other_profile" />
    </fragment>

    <fragment
        android:id="@+id/navigation_post_detail_share"
        android:name="com.example.resona.ui.post.fragment.PostDetailShareFragment"
        android:label="추천글 공유">
        <argument android:name="postId" app:argType="long" />
        <argument android:name="finalSubject" app:argType="string" />
        <argument android:name="finalContent" app:argType="string" />
        <argument android:name="finalTag" app:argType="string" />
        <argument android:name="videoId" app:argType="string" />
    </fragment>

</navigation>